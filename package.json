{
  "name": "recenter",
  "productName": "Recenter",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Recenter — Return to what matters. Personal desktop reminders.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "npm run build && node tests/electron-smoke.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "icons": "node scripts/generate-icons.cjs",
    "test:install": "node scripts/test-install.cjs",
    "verify:installer": "node scripts/verify-installer.cjs",
    "dist:win": "npm run icons && npm run build && electron-builder --win nsis --x64 --publish never && npm run verify:installer"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "build": {
    "afterPack": "scripts/windows-metadata.cjs",
    "appId": "com.reminders.desktop",
    "productName": "Recenter",
    "copyright": "Copyright (c) 2026 Nabia Noor",
    "directories": {
      "output": "release/recenter"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "!**/popup-preview.png",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "Recenter"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Recenter",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Recenter-Setup-${version}-${arch}.${ext}"
    }
  }
}
